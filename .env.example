# Community / multiplayer (v11.25+) — three backends behind one API.
#
# v11.27 — SELF-HOSTED SQLITE (recommended for VPS, zero extra service):
#   The game auto-detects /api/social/ping at runtime. Just run
#   `next build && next start` on your VPS — no env vars needed. The SQLite
#   database lives at ./data/social.db (override with SOCIAL_DB_PATH).
#   The file is gitignored; back it up like any other data.
#
#   Optional for the /admin dashboard:
#     ADMIN_KEY=your-long-random-secret     # /admin asks for this key
#     SOCIAL_DB_PATH=/var/lib/huyenbao/social.db
#   Optional override (skip the auto-detect probe):
#     NEXT_PUBLIC_SOCIAL_BACKEND=sqlite
#
# Supabase (cloud, optional): when both vars are set, the community runs on
# Supabase instead — create a free project at supabase.com, run
# public/hb-supabase-schema.sql in the SQL editor and enable Anonymous
# sign-ins. The supabase-js client is loaded from CDN at runtime, so the
# npm dependency (and VPS build failures like "Can't resolve
# '@supabase/supabase-js'") are gone for good.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# Without any of the above the game runs the same-device demo mode.

# ---------------------------------------------------------------------------
# Local LLM backend (v12.9 — standardised)
# ---------------------------------------------------------------------------
# Every LLM-backed route (/api/story, /api/tarot, /api/divine, /api/deduce,
# /api/phongthuy, /api/post, /api/tuvi, /api/items/generate) reads the SAME
# env var so a single Ollama / llama.cpp / vLLM instance powers all of them.
#
# Default is http://127.0.0.1:8888 — single-machine Ollama install works out
# of the box. Override only if your LLM runs on another host. Do NOT use
# 0.0.0.0 here: that is a BIND address, not a request target, and several
# HTTP clients refuse to send requests to it.
# LLM_BASE_URL=http://127.0.0.1:8888
# LLM_MODEL=qwen2.5:7b
# LLM_TIMEOUT_MS=20000
#
# ---------------------------------------------------------------------------
# GitHub auto-deploy webhook (v11.52+)
# ---------------------------------------------------------------------------
# Set this to the secret you configured in the GitHub webhook settings. The
# /api/deploy route verifies the X-Hub-Signature-256 HMAC and runs
# scripts/deploy.sh (relative to DEPLOY_REPO_PATH) in a detached process.
# Without it the route returns 503 — fail-closed so a misconfigured prod
# can't be triggered.
# DEPLOY_WEBHOOK_SECRET=your-long-random-secret
# DEPLOY_REPO_PATH=/var/www/tycoon-life
# DEPLOY_BRANCH=main

