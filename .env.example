# Community / multiplayer (v11.25) — create a free project at supabase.com,
# run public/hb-supabase-schema.sql in the SQL editor, enable Anonymous
# sign-ins, then fill these in and rebuild. Without them the game runs the
# same-device demo mode.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
