# HuyenBao — reverse proxy cho mogul.huyenbao.com (Caddy)
#
# mogul.huyenbao.com (v11.35) = domain GAME-FIRST — admin dashboard dời về /ads:
#   /        → game đầy đủ có backend xã hội (mở domain vào là chơi)
#   /ads     → admin dashboard toàn diện (7 tab)   |   /adm cũ → alias rewrite → /ads
#   /game    → alias rewrite → /                    |   /admin → 404
#   /api/*   → social + admin API (chặn bằng ADMIN_KEY)
#
# Cài: đặt file này thành /etc/caddy/Caddyfile (hoặc import vào file chính)
# rồi:  sudo systemctl reload caddy
#
# Caddy tự lo HTTPS (Let's Encrypt) — không cần certbot.
# `npm start` trên VPS phải chạy trước: next start -H 0.0.0.0 -p 3334
# Caddy tự truyền đúng header Host cho upstream → src/proxy.ts hoạt động.

mogul.huyenbao.com {
        # GZIP + HTTP/2/3 mặc định của Caddy
        encode zstd gzip

        reverse_proxy 127.0.0.1:3334 {
                # health check nhanh, không chặn khi game server restart ngắn
                health_uri /version.json
                health_interval 15s
                health_timeout 5s
        }

        header {
                Strict-Transport-Security "max-age=31536000"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                -Server
        }

        # Log vào journal (xem bằng: journalctl -u caddy | grep mogul)
        log {
                output stderr
        }
}
